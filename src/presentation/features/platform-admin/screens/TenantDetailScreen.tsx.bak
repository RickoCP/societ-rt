'use client';

/**
 * TenantDetailScreen — Platform Admin screen for viewing comprehensive tenant information.
 *
 * Displays detailed tenant information for platform administrators:
 * - Profile: Full tenant profile including contact information
 * - Subscription: Plan details, features, limits, and usage
 * - Members: Member count and distribution by role
 * - Audit: Recent audit logs (last 100 entries)
 *
 * This screen follows the Clean Architecture pattern:
 * Screen → ViewModel → UseCase → Repository
 *
 * Features:
 * - Tabbed interface with four tabs: Profile, Subscription, Members, Audit
 * - Loading skeleton while data fetches
 * - Error state with retry button
 * - Permission guard requiring PLATFORM_ADMIN role
 * - Mobile responsive design
 *
 * @see Requirements 20.1 (Platform Admin Tenant Operations)
 * @see Design Components > 11. Platform Admin Dashboard > TenantDetail
 */

import { useCallback } from 'react';
import { useTranslation } from 'react-i18next';
import { PermissionGuard } from '@presentation/components/atoms/PermissionGuard';
import { Button } from '@presentation/components/atoms/Button';
import { DataTable } from '@presentation/components/organisms/DataTable';
import {
  useTenantDetailViewModel,
  type TenantDetailTab,
  TENANT_DETAIL_TABS,
  TAB_CONFIG,
  LIFECYCLE_STATUS_CONFIG,
  SUBSCRIPTION_STATUS_CONFIG,
  type AuditLogEntry,
} from '../viewModel/useTenantDetailViewModel';

// ---------------------------------------------------------------------------
// Props
// ---------------------------------------------------------------------------

interface TenantDetailScreenProps {
  /**
   * ID of the tenant to display.
   */
  tenantId: string;
}

// ---------------------------------------------------------------------------
// Subcomponents
// ---------------------------------------------------------------------------

/**
 * Breadcrumb navigation for tenant detail page.
 */
function TenantDetailBreadcrumb({
  tenantName,
}: {
  tenantName: string | null;
}) {
  const { t } = useTranslation();

  return (
    <nav className="mb-4 flex items-center gap-2 text-sm" aria-label="Breadcrumb">
      <a
        href="/dashboard/admin"
        className="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">
        {t('navigation.platform_admin', 'Platform Admin')}
      </a>
      <svg
        className="h-4 w-4 text-gray-400"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true">
        <path
          strokeLinecap="round"
          strokeLinejoin="round"
          strokeWidth={2}
          d="M9 5l7 7-7 7"
        />
      </svg>
      <a
        href="/dashboard/admin/tenants"
        className="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">
        {t('platform.tenants_list', 'Tenants')}
      </a>
      <svg
        className="h-4 w-4 text-gray-400"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true">
        <path
          strokeLinecap="round"
          strokeLinejoin="round"
          strokeWidth={2}
          d="M9 5l7 7-7 7"
        />
      </svg>
      <span className="font-medium text-gray-900 dark:text-white">
        {tenantName ?? t('platform.tenant_detail.title', 'Tenant Detail')}
      </span>
    </nav>
  );
}

/**
 * Tab button component for the detail tabs.
 */
function TabButton({
  tab,
  isActive,
  onClick,
}: {
  tab: TenantDetailTab;
  isActive: boolean;
  onClick: () => void;
}) {
  const { t } = useTranslation();
  const config = TAB_CONFIG[tab];

  return (
    <button
      type="button"
      role="tab"
      aria-selected={isActive}
      aria-controls={`${tab}-panel`}
      id={`${tab}-tab`}
      onClick={onClick}
      className={`
        flex items-center gap-2 whitespace-nowrap rounded-lg px-4 py-2.5 text-sm font-medium transition-colors
        ${
          isActive
            ? 'bg-blue-600 text-white shadow-sm dark:bg-blue-500'
            : 'bg-gray-100 text-gray-700 hover:bg-gray-200 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-gray-700'
        }
      `}>
      <span role="img" aria-hidden="true">
        {config.icon}
      </span>
      <span>{t(config.labelKey, tab)}</span>
    </button>
  );
}

/**
 * Loading skeleton for the tenant detail screen.
 */
function TenantDetailSkeleton() {
  return (
    <div className="animate-pulse space-y-6">
      {/* Header skeleton */}
      <div className="space-y-2">
        <div className="h-8 w-64 rounded bg-gray-200 dark:bg-gray-700" />
        <div className="h-4 w-96 rounded bg-gray-200 dark:bg-gray-700" />
      </div>

      {/* Status badges skeleton */}
      <div className="flex gap-3">
        <div className="h-7 w-24 rounded-full bg-gray-200 dark:bg-gray-700" />
        <div className="h-7 w-28 rounded-full bg-gray-200 dark:bg-gray-700" />
      </div>

      {/* Tabs skeleton */}
      <div className="flex gap-2">
        <div className="h-10 w-28 rounded-lg bg-gray-200 dark:bg-gray-700" />
        <div className="h-10 w-32 rounded-lg bg-gray-200 dark:bg-gray-700" />
        <div className="h-10 w-28 rounded-lg bg-gray-200 dark:bg-gray-700" />
        <div className="h-10 w-24 rounded-lg bg-gray-200 dark:bg-gray-700" />
      </div>

      {/* Content skeleton */}
      <div className="rounded-lg border border-gray-200 bg-white p-6 dark:border-gray-700 dark:bg-gray-900">
        <div className="space-y-4">
          {/* Form fields skeleton */}
          {Array.from({ length: 4 }).map((_, i) => (
            <div key={i} className="space-y-2">
              <div className="h-4 w-24 rounded bg-gray-200 dark:bg-gray-700" />
              <div className="h-10 w-full rounded bg-gray-200 dark:bg-gray-700" />
            </div>
          ))}
        </div>
      </div>
    </div>
  );
}

/**
 * Error state component with retry button.
 */
function TenantDetailError({
  error,
  onRetry,
  onBack,
}: {
  error: { code: string; message: string } | null;
  onRetry: () => void;
  onBack: () => void;
}) {
  const { t } = useTranslation();

  return (
    <div className="flex flex-col items-center justify-center rounded-lg border border-red-200 bg-red-50 py-12 dark:border-red-900 dark:bg-red-900/20">
      <svg
        className="mb-4 h-12 w-12 text-red-400"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true">
        <path
          strokeLinecap="round"
          strokeLinejoin="round"
          strokeWidth={2}
          d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
        />
      </svg>
      <h3 className="text-lg font-medium text-red-800 dark:text-red-200">
        {t('platform.tenant_detail.fetch_error', 'Failed to load tenant details')}
      </h3>
      <p className="mt-1 text-sm text-red-600 dark:text-red-400">
        {t(
          'platform.tenant_detail.generic_error',
          'An error occurred while fetching tenant details. Please try again.',
        )}
      </p>
      <div className="mt-4 flex gap-3">
      {error?.code && (
        <p className="mt-2 text-xs text-red-500 dark:text-red-500">
          {t('common.error_code', 'Error code: {{code}}', { code: error.code })}
        </p>
      )}
      <div className="mt-4 flex gap-3">
        <Button variant="secondary" size="sm" onClick={onBack}>
          {t('common.go_back', 'Go Back')}
        </Button>
        <Button variant="primary" size="sm" onClick={onRetry}>
          {t('common.retry', 'Retry')}
        </Button>
      </div>
    </div>
  );
}

/**
 * Unauthorized message component.
 * @see Requirements 19.2
 */
function UnauthorizedMessage() {
  const { t } = useTranslation();

  return (
    <div className="flex flex-col items-center justify-center py-12">
      <svg
        className="mb-4 h-12 w-12 text-gray-400"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true">
        <path
          strokeLinecap="round"
          strokeLinejoin="round"
          strokeWidth={2}
          d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
        />
      </svg>
      <h2 className="text-lg font-medium text-gray-900 dark:text-white">
        {t('platform.unauthorized', 'Access Denied')}
      </h2>
      <p className="mt-1 text-sm text-gray-500 dark:text-gray-400">
        {t(
          'platform.unauthorized_description',
          'You do not have permission to access the platform administration.',
        )}
      </p>
    </div>
  );
}

// ---------------------------------------------------------------------------
// Tab Content Components
// ---------------------------------------------------------------------------

/**
 * Profile Tab Content.
 * Displays full tenant profile information.
 * @see Requirements 20.1
 */
function ProfileTabContent({
  vm,
}: {
  vm: ReturnType<typeof useTenantDetailViewModel>;
}) {
  const { t } = useTranslation();
  const { profile, tenantDetail } = vm;

  if (!profile || !tenantDetail) {
    return null;
  }

  return (
    <div className="rounded-lg border border-gray-200 bg-white p-6 dark:border-gray-700 dark:bg-gray-900">
      {/* Profile Header */}
      <div className="mb-6 flex items-start gap-4">
        {profile.logoUrl ? (
          <img
            src={profile.logoUrl}
            alt={`${profile.name} logo`}
            className="h-16 w-16 rounded-lg object-cover"
          />
        ) : (
          <div className="flex h-16 w-16 items-center justify-center rounded-lg bg-gray-200 text-2xl dark:bg-gray-700">
            🏢
          </div>
        )}
        <div>
          <h3 className="text-lg font-semibold text-gray-900 dark:text-white">
            {profile.name}
          </h3>
          <p className="text-sm text-gray-500 dark:text-gray-400">
            {tenantDetail.slug}
          </p>
        </div>
      </div>

      {/* Profile Fields Grid */}
      <div className="grid gap-6 md:grid-cols-2">
        {/* RT/RW Number */}
        <div>
          <label className="block text-sm font-medium text-gray-500 dark:text-gray-400">
            {t('platform.tenant_detail.rt_rw_number', 'RT/RW Number')}
          </label>
          <p className="mt-1 text-gray-900 dark:text-white">
            {profile.rtRwNumber ?? '-'}
          </p>
        </div>

        {/* Region */}
        <div>
          <label className="block text-sm font-medium text-gray-500 dark:text-gray-400">
            {t('platform.tenant_detail.region', 'Region')}
          </label>
          <p className="mt-1 text-gray-900 dark:text-white">
            {profile.region ?? '-'}
          </p>
        </div>

        {/* Address */}
        <div className="md:col-span-2">
          <label className="block text-sm font-medium text-gray-500 dark:text-gray-400">
            {t('platform.tenant_detail.address', 'Address')}
          </label>
          <p className="mt-1 text-gray-900 dark:text-white">
            {profile.address ?? '-'}
          </p>
        </div>

        {/* Contact Person */}
        <div>
          <label className="block text-sm font-medium text-gray-500 dark:text-gray-400">
            {t('platform.tenant_detail.contact_person', 'Contact Person')}
          </label>
          <p className="mt-1 text-gray-900 dark:text-white">
            {profile.contactPerson ?? '-'}
          </p>
        </div>

        {/* Contact Email */}
        <div>
          <label className="block text-sm font-medium text-gray-500 dark:text-gray-400">
            {t('platform.tenant_detail.contact_email', 'Contact Email')}
          </label>
          <p className="mt-1 text-gray-900 dark:text-white">
            {profile.contactEmail ?? '-'}
          </p>
        </div>

        {/* Contact Phone */}
        <div>
          <label className="block text-sm font-medium text-gray-500 dark:text-gray-400">
            {t('platform.tenant_detail.contact_phone', 'Contact Phone')}
          </label>
          <p className="mt-1 text-gray-900 dark:text-white">
            {profile.contactPhone ?? '-'}
          </p>
        </div>

        {/* Created Date */}
        <div>
          <label className="block text-sm font-medium text-gray-500 dark:text-gray-400">
            {t('platform.tenant_detail.created_at', 'Created At')}
          </label>
          <p className="mt-1 text-gray-900 dark:text-white">
            {tenantDetail.createdAt.toLocaleDateString()}
          </p>
        </div>

        {/* Branding Colors */}
        {(profile.primaryColor || profile.secondaryColor) && (
          <div className="md:col-span-2">
            <label className="block text-sm font-medium text-gray-500 dark:text-gray-400">
              {t('platform.tenant_detail.branding_colors', 'Branding Colors')}
            </label>
            <div className="mt-2 flex items-center gap-4">
              {profile.primaryColor && (
                <div className="flex items-center gap-2">
                  <div
                    className="h-6 w-6 rounded border border-gray-300"
                    style={{ backgroundColor: profile.primaryColor }}
                  />
                  <span className="text-sm text-gray-600 dark:text-gray-300">
                    {t('platform.tenant_detail.primary', 'Primary')}
                  </span>
                </div>
              )}
              {profile.secondaryColor && (
                <div className="flex items-center gap-2">
                  <div
                    className="h-6 w-6 rounded border border-gray-300"
                    style={{ backgroundColor: profile.secondaryColor }}
                  />
                  <span className="text-sm text-gray-600 dark:text-gray-300">
                    {t('platform.tenant_detail.secondary', 'Secondary')}
                  </span>
                </div>
              )}
            </div>
          </div>
        )}
      </div>

      {/* Lifecycle History Section */}
      {vm.lifecycleHistory.length > 0 && (
        <div className="mt-8">
          <h4 className="mb-4 text-md font-semibold text-gray-900 dark:text-white">
            {t('platform.tenant_detail.lifecycle_history', 'Lifecycle History')}
          </h4>
          <div className="space-y-3">
            {vm.lifecycleHistory.slice(0, 5).map(event => {
              const statusConfig = LIFECYCLE_STATUS_CONFIG[event.toStatus];
              return (
                <div
                  key={event.id}
                  className="flex items-center justify-between rounded-lg border border-gray-200 bg-gray-50 p-3 dark:border-gray-700 dark:bg-gray-800">
                  <div className="flex items-center gap-3">
                    <span
                      className={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-medium ${statusConfig?.color ?? ''}`}>
                      <span role="img" aria-hidden="true">
                        {statusConfig?.icon}
                      </span>
                      {event.toStatus}
                    </span>
                    <span className="text-sm text-gray-600 dark:text-gray-300">
                      {event.action}
                    </span>
                    {event.reason && (
                      <span className="text-xs text-gray-500 dark:text-gray-400">
                        ({event.reason})
                      </span>
                    )}
                  </div>
                  <div className="text-right">
                    <p className="text-xs text-gray-500 dark:text-gray-400">
                      {event.actorName ?? t('common.system', 'System')}
                    </p>
                    <p className="text-xs text-gray-400 dark:text-gray-500">
                      {event.timestamp.toLocaleString()}
                    </p>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      )}
    </div>
  );
}

/**
 * Subscription Tab Content.
 * Displays subscription details, features, limits, and usage.
 * @see Requirements 20.1
 */
function SubscriptionTabContent({
  vm,
}: {
  vm: ReturnType<typeof useTenantDetailViewModel>;
}) {
  const { t } = useTranslation();
  const { subscriptionDetails, tenantDetail } = vm;

  if (!subscriptionDetails || !tenantDetail) {
    return null;
  }

  const subscription = tenantDetail.subscription;
  const statusConfig = SUBSCRIPTION_STATUS_CONFIG[subscription.status] ?? {
    label: subscription.status,
    color: 'text-gray-600 bg-gray-100',
  };

  const { limits, usage } = subscriptionDetails;

  // Calculate usage percentages
  const memberUsagePercent =
    limits.maxMembers && limits.maxMembers > 0
      ? Math.round((usage.memberCount / limits.maxMembers) * 100)
      : 0;
  const orgUnitUsagePercent =
    limits.maxOrgUnits && limits.maxOrgUnits > 0
      ? Math.round((usage.orgUnitCount / limits.maxOrgUnits) * 100)
      : 0;
  const storageUsagePercent =
    limits.maxStorage && limits.maxStorage > 0
      ? Math.round((usage.storageUsedBytes / limits.maxStorage) * 100)
      : 0;

  const formatStorage = (bytes: number): string => {
    if (bytes >= 1024 * 1024 * 1024) {
      return `${(bytes / (1024 * 1024 * 1024)).toFixed(2)} GB`;
    }
    if (bytes >= 1024 * 1024) {
      return `${(bytes / (1024 * 1024)).toFixed(2)} MB`;
    }
    return `${(bytes / 1024).toFixed(2)} KB`;
  };

  return (
    <div className="space-y-6">
      {/* Plan Overview Card */}
      <div className="rounded-lg border border-gray-200 bg-white p-6 dark:border-gray-700 dark:bg-gray-900">
        <div className="flex flex-wrap items-start justify-between gap-4">
          <div>
            <h3 className="text-lg font-semibold text-gray-900 dark:text-white">
              {subscription.planName}
            </h3>
            <p className="text-sm text-gray-500 dark:text-gray-400">
              {t('platform.tenant_detail.plan_id', 'Plan ID')}: {subscription.planId}
            </p>
          </div>
          <span
            className={`inline-flex items-center rounded-full px-3 py-1 text-sm font-medium ${statusConfig.color}`}>
            {t(`subscription.status.${subscription.status.toLowerCase()}`, statusConfig.label)}
          </span>
        </div>

        {/* Trial Info */}
        {subscription.isTrial && subscription.trialDaysRemaining !== null && (
          <div className="mt-4 rounded-md border border-blue-200 bg-blue-50 p-3 dark:border-blue-900 dark:bg-blue-900/20">
            <div className="flex items-center gap-2">
              <span className="text-blue-600 dark:text-blue-400">⏳</span>
              <span className="text-sm font-medium text-blue-700 dark:text-blue-300">
                {t('platform.tenant_detail.trial_days_remaining', {
                  defaultValue: '{{days}} days remaining in trial',
                  days: subscription.trialDaysRemaining,
                })}
              </span>
            </div>
          </div>
        )}

        {/* Billing Period */}
        <div className="mt-4 grid gap-4 md:grid-cols-2">
          <div>
            <label className="block text-sm font-medium text-gray-500 dark:text-gray-400">
              {t('platform.tenant_detail.period_start', 'Period Start')}
            </label>
            <p className="mt-1 text-gray-900 dark:text-white">
              {subscriptionDetails.currentPeriodStart?.toLocaleDateString() ?? '-'}
            </p>
          </div>
          <div>
            <label className="block text-sm font-medium text-gray-500 dark:text-gray-400">
              {t('platform.tenant_detail.period_end', 'Period End')}
            </label>
            <p className="mt-1 text-gray-900 dark:text-white">
              {subscriptionDetails.currentPeriodEnd?.toLocaleDateString() ?? '-'}
            </p>
          </div>
        </div>
      </div>

      {/* Usage Metrics Card */}
      <div className="rounded-lg border border-gray-200 bg-white p-6 dark:border-gray-700 dark:bg-gray-900">
        <h4 className="mb-4 text-md font-semibold text-gray-900 dark:text-white">
          {t('platform.tenant_detail.usage_metrics', 'Usage Metrics')}
        </h4>

        <div className="space-y-4">
          {/* Members Usage */}
          <div>
            <div className="mb-1 flex items-center justify-between text-sm">
              <span className="text-gray-600 dark:text-gray-300">
                {t('platform.tenant_detail.members_usage', 'Members')}
              </span>
              <span
                className={`font-medium ${memberUsagePercent >= 80 ? 'text-red-600 dark:text-red-400' : 'text-gray-900 dark:text-white'}`}>
                {usage.memberCount} / {limits.maxMembers ?? '∞'}
              </span>
            </div>
            <div className="h-2 w-full rounded-full bg-gray-200 dark:bg-gray-700">
              <div
                className={`h-2 rounded-full ${memberUsagePercent >= 80 ? 'bg-red-500' : 'bg-blue-500'}`}
                style={{ width: `${Math.min(memberUsagePercent, 100)}%` }}
              />
            </div>
          </div>

          {/* OrgUnits Usage */}
          <div>
            <div className="mb-1 flex items-center justify-between text-sm">
              <span className="text-gray-600 dark:text-gray-300">
                {t('platform.tenant_detail.orgunits_usage', 'Organizational Units')}
              </span>
              <span
                className={`font-medium ${orgUnitUsagePercent >= 80 ? 'text-red-600 dark:text-red-400' : 'text-gray-900 dark:text-white'}`}>
                {usage.orgUnitCount} / {limits.maxOrgUnits ?? '∞'}
              </span>
            </div>
            <div className="h-2 w-full rounded-full bg-gray-200 dark:bg-gray-700">
              <div
                className={`h-2 rounded-full ${orgUnitUsagePercent >= 80 ? 'bg-red-500' : 'bg-green-500'}`}
                style={{ width: `${Math.min(orgUnitUsagePercent, 100)}%` }}
              />
            </div>
          </div>

          {/* Storage Usage */}
          <div>
            <div className="mb-1 flex items-center justify-between text-sm">
              <span className="text-gray-600 dark:text-gray-300">
                {t('platform.tenant_detail.storage_usage', 'Storage')}
              </span>
              <span
                className={`font-medium ${storageUsagePercent >= 80 ? 'text-red-600 dark:text-red-400' : 'text-gray-900 dark:text-white'}`}>
                {formatStorage(usage.storageUsedBytes)} / {limits.maxStorage ? formatStorage(limits.maxStorage) : '∞'}
              </span>
            </div>
            <div className="h-2 w-full rounded-full bg-gray-200 dark:bg-gray-700">
              <div
                className={`h-2 rounded-full ${storageUsagePercent >= 80 ? 'bg-red-500' : 'bg-purple-500'}`}
                style={{ width: `${Math.min(storageUsagePercent, 100)}%` }}
              />
            </div>
          </div>
        </div>
      </div>

      {/* Features Card */}
      {subscriptionDetails.features.length > 0 && (
        <div className="rounded-lg border border-gray-200 bg-white p-6 dark:border-gray-700 dark:bg-gray-900">
          <h4 className="mb-4 text-md font-semibold text-gray-900 dark:text-white">
            {t('platform.tenant_detail.included_features', 'Included Features')}
          </h4>
          <div className="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
            {subscriptionDetails.features.map(feature => (
              <div key={feature} className="flex items-center gap-2">
                <span className="text-green-500">✓</span>
                <span className="text-sm text-gray-700 dark:text-gray-300">
                  {feature}
                </span>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  );
}

/**
 * Members Tab Content.
 * Displays member count and distribution by role.
 * @see Requirements 20.1
 */
function MembersTabContent({
  vm,
}: {
  vm: ReturnType<typeof useTenantDetailViewModel>;
}) {
  const { t } = useTranslation();
  const { memberDistribution, tenantDetail } = vm;

  if (!tenantDetail) {
    return null;
  }

  const totalMembers = tenantDetail.memberCount;
  const activeMembers = tenantDetail.activeMemberCount;
  const roles = Object.entries(memberDistribution);

  // Role display configuration
  const ROLE_CONFIG: Record<string, { label: string; color: string; icon: string }> = {
    PLATFORM_ADMIN: {
      label: 'Platform Admin',
      color: 'text-purple-600 bg-purple-100 dark:text-purple-400 dark:bg-purple-900/30',
      icon: '👑',
    },
    TENANT_OWNER: {
      label: 'Tenant Owner',
      color: 'text-blue-600 bg-blue-100 dark:text-blue-400 dark:bg-blue-900/30',
      icon: '🏢',
    },
    ORG_ADMIN: {
      label: 'Org Admin',
      color: 'text-green-600 bg-green-100 dark:text-green-400 dark:bg-green-900/30',
      icon: '🏛️',
    },
    RT_ADMIN: {
      label: 'RT Admin',
      color: 'text-teal-600 bg-teal-100 dark:text-teal-400 dark:bg-teal-900/30',
      icon: '🏘️',
    },
    SECURITY: {
      label: 'Security',
      color: 'text-orange-600 bg-orange-100 dark:text-orange-400 dark:bg-orange-900/30',
      icon: '🛡️',
    },
    RESIDENT: {
      label: 'Resident',
      color: 'text-gray-600 bg-gray-100 dark:text-gray-400 dark:bg-gray-900/30',
      icon: '🏠',
    },
  };

  return (
    <div className="space-y-6">
      {/* Member Count Overview */}
      <div className="grid gap-4 md:grid-cols-3">
        <div className="rounded-lg border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-900">
          <p className="text-sm text-gray-500 dark:text-gray-400">
            {t('platform.tenant_detail.total_members', 'Total Members')}
          </p>
          <p className="mt-1 text-3xl font-semibold text-gray-900 dark:text-white">
            {totalMembers}
          </p>
        </div>
        <div className="rounded-lg border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-900">
          <p className="text-sm text-gray-500 dark:text-gray-400">
            {t('platform.tenant_detail.active_members', 'Active Members')}
          </p>
          <p className="mt-1 text-3xl font-semibold text-green-600 dark:text-green-400">
            {activeMembers}
          </p>
        </div>
        <div className="rounded-lg border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-900">
          <p className="text-sm text-gray-500 dark:text-gray-400">
            {t('platform.tenant_detail.org_units', 'Org Units')}
          </p>
          <p className="mt-1 text-3xl font-semibold text-blue-600 dark:text-blue-400">
            {tenantDetail.orgUnitCount}
          </p>
        </div>
      </div>

      {/* Role Distribution */}
      <div className="rounded-lg border border-gray-200 bg-white p-6 dark:border-gray-700 dark:bg-gray-900">
        <h4 className="mb-4 text-md font-semibold text-gray-900 dark:text-white">
          {t('platform.tenant_detail.role_distribution', 'Role Distribution')}
        </h4>

        {roles.length === 0 ? (
          <p className="text-sm text-gray-500 dark:text-gray-400">
            {t('platform.tenant_detail.no_members', 'No members found.')}
          </p>
        ) : (
          <div className="space-y-3">
            {roles.map(([role, count]) => {
              const config = ROLE_CONFIG[role] ?? {
                label: role,
                color: 'text-gray-600 bg-gray-100',
                icon: '👤',
              };
              const percentage = totalMembers > 0 ? Math.round((count / totalMembers) * 100) : 0;

              return (
                <div key={role} className="flex items-center gap-4">
                  <div className="w-40">
                    <span
                      className={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-medium ${config.color}`}>
                      <span role="img" aria-hidden="true">
                        {config.icon}
                      </span>
                      {t(`roles.${role.toLowerCase()}`, config.label)}
                    </span>
                  </div>
                  <div className="flex-1">
                    <div className="h-2 w-full rounded-full bg-gray-200 dark:bg-gray-700">
                      <div
                        className="h-2 rounded-full bg-blue-500"
                        style={{ width: `${percentage}%` }}
                      />
                    </div>
                  </div>
                  <div className="w-20 text-right">
                    <span className="text-sm font-medium text-gray-900 dark:text-white">
                      {count}
                    </span>
                    <span className="text-xs text-gray-500 dark:text-gray-400">
                      {' '}
                      ({percentage}%)
                    </span>
                  </div>
                </div>
              );
            })}
          </div>
        )}
      </div>
    </div>
  );
}

/**
 * Audit Tab Content.
 * Displays recent audit logs (last 100 entries).
 * @see Requirements 20.1
 */
function AuditTabContent({
  vm,
}: {
  vm: ReturnType<typeof useTenantDetailViewModel>;
}) {
  const { t } = useTranslation();
  const { auditLogs, auditPage, auditTotalPages, setAuditPage } = vm;

  // Format event type for display
  const formatEventType = (type: string): string => {
    return type
      .replace(/_/g, ' ')
      .split(' ')
      .map(word => word.charAt(0).toUpperCase() + word.slice(1).toLowerCase())
      .join(' ');
  };

  // Audit log table columns
  const columns = [
    {
      key: 'timestamp',
      header: t('platform.tenant_detail.audit_timestamp', 'Timestamp'),
      sortable: true,
      render: (row: AuditLogEntry) => (
        <span className="whitespace-nowrap text-gray-900 dark:text-white">
          {row.timestamp.toLocaleString()}
        </span>
      ),
    },
    {
      key: 'eventType',
      header: t('platform.tenant_detail.audit_event', 'Event'),
      sortable: true,
      render: (row: AuditLogEntry) => (
        <span className="inline-flex items-center rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-800 dark:bg-gray-700 dark:text-gray-200">
          {formatEventType(row.eventType)}
        </span>
      ),
    },
    {
      key: 'actor',
      header: t('platform.tenant_detail.audit_actor', 'Actor'),
      render: (row: AuditLogEntry) => (
        <div>
          <p className="text-gray-900 dark:text-white">{row.actor.name}</p>
          <p className="text-xs text-gray-500 dark:text-gray-400">{row.actor.email}</p>
        </div>
      ),
    },
    {
      key: 'resource',
      header: t('platform.tenant_detail.audit_resource', 'Resource'),
      render: (row: AuditLogEntry) => (
        <div>
          <p className="text-gray-900 dark:text-white">
            {row.resource.name ?? row.resource.id}
          </p>
          <p className="text-xs text-gray-500 dark:text-gray-400">
            {row.resource.type}
          </p>
        </div>
      ),
    },
    {
      key: 'ipAddress',
      header: t('platform.tenant_detail.audit_ip', 'IP Address'),
      render: (row: AuditLogEntry) => (
        <span className="text-gray-600 dark:text-gray-300">
          {row.ipAddress ?? '-'}
        </span>
      ),
    },
  ];

  return (
    <div className="rounded-lg border border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-900">
      <div className="border-b border-gray-200 p-4 dark:border-gray-700">
        <h4 className="text-md font-semibold text-gray-900 dark:text-white">
          {t('platform.tenant_detail.recent_audit_logs', 'Recent Audit Logs')}
        </h4>
        <p className="mt-1 text-sm text-gray-500 dark:text-gray-400">
          {t('platform.tenant_detail.audit_description', 'Last 100 audit log entries for this tenant.')}
        </p>
      </div>

      <DataTable
        columns={columns}
        data={auditLogs as AuditLogEntry[]}
        rowKey={(row: AuditLogEntry) => row.id}
        loading={vm.isLoading}
        page={auditPage}
        totalPages={auditTotalPages}
        onPageChange={setAuditPage}
        emptyMessage={t('platform.tenant_detail.no_audit_logs', 'No audit logs found.')}
      />
    </div>
  );
}

// ---------------------------------------------------------------------------
// Main Content Component
// ---------------------------------------------------------------------------

/**
 * TenantDetailContent — The main content of the Tenant Detail screen.
 */
function TenantDetailContent({ tenantId }: TenantDetailScreenProps) {
  const { t } = useTranslation();
  const vm = useTenantDetailViewModel(tenantId);

  // ---------------------------------------------------------------------------
  // Tab Click Handler
  // ---------------------------------------------------------------------------

  const handleTabClick = useCallback(
    (tab: TenantDetailTab) => {
      vm.setTab(tab);
    },
    [vm],
  );

  // ---------------------------------------------------------------------------
  // Render States
  // ---------------------------------------------------------------------------

  // Loading state
  if (vm.isLoading && !vm.tenantDetail) {
    return (
      <div className="space-y-6">
        <TenantDetailBreadcrumb tenantName={null} />
        <TenantDetailSkeleton />
      </div>
    );
  }

  // Error state
  if (vm.isError && !vm.tenantDetail) {
    return (
      <div className="space-y-6">
        <TenantDetailBreadcrumb tenantName={null} />
        <TenantDetailError error={vm.error} onRetry={vm.refetch} onBack={vm.goBack} />
      </div>
    );
  }

  // ---------------------------------------------------------------------------
  // Render Tab Content
  // ---------------------------------------------------------------------------

  const renderTabContent = () => {
    switch (vm.activeTab) {
      case 'profile':
        return <ProfileTabContent vm={vm} />;
      case 'subscription':
        return <SubscriptionTabContent vm={vm} />;
      case 'members':
        return <MembersTabContent vm={vm} />;
      case 'audit':
        return <AuditTabContent vm={vm} />;
      default:
        return null;
    }
  };

  const tenantName = vm.tenantDetail?.name ?? null;
  const lifecycleStatus = vm.tenantDetail?.status;
  const subscriptionStatus = vm.tenantDetail?.subscription?.status;

  // ---------------------------------------------------------------------------
  // Main Render
  // ---------------------------------------------------------------------------

  return (
    <div className="space-y-6">
      {/* Breadcrumb */}
      <TenantDetailBreadcrumb tenantName={tenantName} />

      {/* Header */}
      <div className="flex flex-wrap items-start justify-between gap-4">
        <div>
          <div className="flex items-center gap-3">
            <Button
              variant="ghost"
              size="sm"
              onClick={vm.goBack}
              aria-label={t('common.go_back', 'Go Back')}>
              <svg
                className="h-5 w-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true">
                <path
                  strokeLinecap="round"
                  strokeLinejoin="round"
                  strokeWidth={2}
                  d="M15 19l-7-7 7-7"
                />
              </svg>
            </Button>
            <h1 className="text-2xl font-semibold text-gray-900 dark:text-white">
              {tenantName ?? t('platform.tenant_detail.title', 'Tenant Detail')}
            </h1>
          </div>
          <p className="mt-1 ml-11 text-sm text-gray-500 dark:text-gray-400">
            {t('platform.tenant_detail.description', 'View comprehensive tenant information.')}
          </p>
        </div>

        {/* Status Badges */}
        <div className="flex flex-wrap gap-2">
          {/* Lifecycle Status */}
          {lifecycleStatus && LIFECYCLE_STATUS_CONFIG[lifecycleStatus] && (
            <span
              className={`inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-sm font-medium ${LIFECYCLE_STATUS_CONFIG[lifecycleStatus].color}`}>
              <span role="img" aria-hidden="true">
                {LIFECYCLE_STATUS_CONFIG[lifecycleStatus].icon}
              </span>
              {t(
                `platform.tenant_status.${lifecycleStatus.toLowerCase()}`,
                LIFECYCLE_STATUS_CONFIG[lifecycleStatus].label,
              )}
            </span>
          )}
          {/* Subscription Status */}
          {subscriptionStatus && SUBSCRIPTION_STATUS_CONFIG[subscriptionStatus] && (
            <span
              className={`inline-flex items-center rounded-full px-3 py-1 text-sm font-medium ${SUBSCRIPTION_STATUS_CONFIG[subscriptionStatus].color}`}>
              {t(
                `subscription.status.${subscriptionStatus.toLowerCase()}`,
                SUBSCRIPTION_STATUS_CONFIG[subscriptionStatus].label,
              )}
            </span>
          )}
        </div>
      </div>

      {/* Pending Alerts Warning */}
      {vm.tenantDetail?.hasPendingAlerts && (
        <div className="rounded-md border border-orange-200 bg-orange-50 px-4 py-3 dark:border-orange-900 dark:bg-orange-900/20">
          <div className="flex items-center gap-2">
            <svg
              className="h-5 w-5 text-orange-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true">
              <path
                strokeLinecap="round"
                strokeLinejoin="round"
                strokeWidth={2}
                d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
              />
            </svg>
            <span className="text-sm font-medium text-orange-700 dark:text-orange-300">
              {t('platform.tenant_detail.pending_alerts_warning', {
                defaultValue: 'This tenant has {{count}} pending alert(s).',
                count: vm.tenantDetail.pendingAlertCount,
              })}
            </span>
          </div>
        </div>
      )}

      {/* Tab Navigation */}
      <div
        role="tablist"
        aria-label={t('platform.tenant_detail.tabs_label', 'Tenant detail sections')}
        className="flex flex-wrap gap-2">
        {TENANT_DETAIL_TABS.map(tab => (
          <TabButton
            key={tab}
            tab={tab}
            isActive={vm.activeTab === tab}
            onClick={() => handleTabClick(tab)}
          />
        ))}
      </div>

      {/* Tab Content Panel */}
      <div
        role="tabpanel"
        id={`${vm.activeTab}-panel`}
        aria-labelledby={`${vm.activeTab}-tab`}
        tabIndex={0}>
        {renderTabContent()}
      </div>
    </div>
  );
}

// ---------------------------------------------------------------------------
// Exported Component
// ---------------------------------------------------------------------------

/**
 * TenantDetailScreen — The Tenant Detail screen for Platform Admin wrapped with PermissionGuard.
 *
 * Requires PLATFORM_ADMIN role to access.
 * @see Requirements 20.1
 *
 * @example
 * ```tsx
 * // In app/dashboard/admin/tenants/[tenantId]/page.tsx
 * import { TenantDetailScreen } from '@presentation/features/platform-admin/screens/TenantDetailScreen';
 *
 * export default function TenantDetailPage({ params }: { params: { tenantId: string } }) {
 *   return <TenantDetailScreen tenantId={params.tenantId} />;
 * }
 * ```
 */
export function TenantDetailScreen({ tenantId }: TenantDetailScreenProps) {
  return (
    <PermissionGuard
      permissions={['platform:manage']}
      fallback={<UnauthorizedMessage />}>
      <TenantDetailContent tenantId={tenantId} />
    </PermissionGuard>
  );
}

export default TenantDetailScreen;
