// =============================================================================
// IoT Device Enums & Models
// =============================================================================

enum IoTDeviceType {
  panic_button
  smart_siren
  smart_lock
  cctv
  motion_sensor
  smoke_detector
  door_sensor
  gate_sensor
  smart_switch
  smart_lighting
}

enum IoTDeviceOnlineStatus {
  online
  offline
}

enum DeviceEventType {
  panic_button_pressed
  gate_open
  gate_closed
  motion_detected
  smoke_detected
  alarm_triggered
  smart_lock_opened
  cctv_motion_detected
  device_online
  device_offline
  battery_low
  emergency_alert
  smart_switch_toggled
  lighting_changed
  gate_open_too_long
  motion_detection_alert
  door_opened
  door_closed
  door_opened_during_window
}

/// IoTDevice represents a smart home device paired with a Household via Tuya IoT Cloud.
/// Each device belongs to a tenant and is associated with a specific household.
model IoTDevice {
  id           String                @id @default(uuid()) @map("id")
  tenantId     String                @map("tenant_id")
  householdId  String                @map("household_id")
  tuyaDeviceId String                @map("tuya_device_id")
  deviceType   IoTDeviceType         @map("device_type")
  name         String                @map("name")
  onlineStatus IoTDeviceOnlineStatus @default(offline) @map("online_status")
  batteryLevel Int?                  @map("battery_level")
  lastSeen     DateTime              @default(now()) @map("last_seen")
  metadata     Json                  @default("{}") @map("metadata")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  household        Household         @relation(fields: [householdId], references: [id])
