// =============================================================================
// SocieT-RT Prisma Schema
// Multi-tenant SaaS platform for RT/RW community management
// =============================================================================
// Conventions:
// - All TypeScript field names use camelCase
// - All database columns use snake_case via @map directives
// - All table names use snake_case plural via @@map directives
// - All IDs are UUIDs with @default(uuid())
// - All models have created_at, updated_at timestamps
// - Models supporting soft delete have deleted_at nullable timestamp
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// Enums
// =============================================================================

enum TenantStatus {
  active
  suspended
}

enum UserRole {
  Super_Admin
  Ketua_RT
  Pengurus
  Warga
  Security_Guard
}

enum UserStatus {
  active
  locked
  inactive
}

enum ResidencyStatus {
  tetap
  kontrak
  kos
  pindah
}

enum Gender {
  male
  female
}

enum TransactionType {
  income
  expense
}

enum IuranPaymentStatus {
  paid
  unpaid
}

enum VoteMode {
  anonymous
  verified
}

enum AnnouncementCategory {
  umum
  keamanan
  keuangan
  kegiatan
  darurat
}

// =============================================================================
// Models
// =============================================================================

/// Subscription plan that determines feature limits and user count limits per tenant.
model SubscriptionPlan {
  id        String   @id @default(uuid()) @map("id")
  name      String   @map("name") // Free, Pro, Enterprise
  maxUsers  Int?     @map("max_users") // null = unlimited
  features  String[] @map("features")
  price     Decimal  @map("price") @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenants Tenant[]

  @@map("subscription_plans")
}

/// Tenant represents a single RT/RW/cluster/community organization.
/// All tenant-scoped data references this model via tenant_id.
model Tenant {
  id                 String       @id @default(uuid()) @map("id")
  name               String       @map("name")
  subdomain          String       @unique @map("subdomain")
  rtRwNumber         String       @map("rt_rw_number")
  region             String       @map("region")
  address            String       @map("address")
  contactPerson      String       @map("contact_person")
  logoUrl            String?      @map("logo_url")
  primaryColor       String?      @map("primary_color")
  secondaryColor     String?      @map("secondary_color")
  sirenDeviceId      String?      @map("siren_device_id")
  status             TenantStatus @default(active) @map("status")
  subscriptionPlanId String       @map("subscription_plan_id")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  subscriptionPlan      SubscriptionPlan       @relation(fields: [subscriptionPlanId], references: [id])
  users                 User[]
  invitationTokens      InvitationToken[]
  households            Household[]
  residents             Resident[]
  financialTransactions FinancialTransaction[]
  iuranStatuses         IuranStatus[]
  votes                 Vote[]
  announcements         Announcement[]
  emergencyAlerts       EmergencyAlert[]
  patrolSchedules       PatrolSchedule[]
  incidentReports       IncidentReport[]
  letterRequests        LetterRequest[]
  communityEvents       CommunityEvent[]
  visitorLogs           VisitorLog[]
  packageLogs           PackageLog[]
  invoices              Invoice[]
  featureFlagOverrides  FeatureFlagOverride[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  pushSubscriptions     PushSubscription[]
  iotDevices            IoTDevice[]
  incidents             Incident[]
  gates                 Gate[]
  cctvCameras           CctvCamera[]
  patrolRoutes          PatrolRoute[]
  patrolSessions        PatrolSession[]
  alarmDevices          AlarmDevice[]
  automationRules       AutomationRule[]
  homes                 Home[]
  doorSensorConfigs        DoorSensorConfig[]
  doorInstallationRequests DoorInstallationRequest[]
  emergencyContacts        EmergencyContact[]

  // M1 (FASE 1.2b) additive back-relations. Does not change the tenants table columns.
  orgUnits    OrgUnit[]
  memberships Membership[]

  @@unique([rtRwNumber, region], map: "tenants_rt_rw_number_region_unique")
  @@map("tenants")
}

/// User represents an authenticated user within a tenant.
/// Supports soft delete via deleted_at timestamp.
model User {
  id                  String     @id @default(uuid()) @map("id")
  tenantId            String     @map("tenant_id")
  name                String     @map("name")
  email               String     @map("email")
  passwordHash        String     @map("password_hash")
  role                UserRole   @default(Warga) @map("role")
  status              UserStatus @default(active) @map("status")
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until")
  consentTimestamp    DateTime?  @map("consent_timestamp")
  consentVersion      String?    @map("consent_version")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")
  deletedAt           DateTime?  @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  // M1 (FASE 1.2b) additive back-relation. Does not change the users table columns.
  memberships Membership[]

  @@unique([tenantId, email], map: "users_tenant_id_email_unique")
  @@index([tenantId, id], map: "users_tenant_id_id_idx")
  @@index([tenantId, createdAt], map: "users_tenant_id_created_at_idx")
  @@index([tenantId, status], map: "users_tenant_id_status_idx")
  @@map("users")
}

/// Invitation token for user registration. Created by Ketua_RT or Pengurus.
model InvitationToken {
  id        String    @id @default(uuid()) @map("id")
  tenantId  String    @map("tenant_id")
  email     String    @map("email")
  role      UserRole  @map("role")
  token     String    @unique @map("token")
  expiresAt DateTime  @map("expires_at")
  createdBy String    @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  usedAt    DateTime? @map("used_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, id], map: "invitation_tokens_tenant_id_id_idx")
  @@index([tenantId, createdAt], map: "invitation_tokens_tenant_id_created_at_idx")
  @@map("invitation_tokens")
}

/// Household represents a family unit (Kartu Keluarga) within a tenant's community.
model Household {
  id              String   @id @default(uuid()) @map("id")
  tenantId        String   @map("tenant_id")
  householdNumber String   @map("household_number")
  address         String   @map("address")
  block           String?  @map("block")
  latitude        Float?   @map("latitude")
  longitude       Float?   @map("longitude")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  residents     Resident[]
  iuranStatuses IuranStatus[]
  iotDevices    IoTDevice[]
  doorSensorConfig         DoorSensorConfig?
  doorInstallationRequests DoorInstallationRequest[]

  @@unique([tenantId, householdNumber], map: "households_tenant_id_household_number_unique")
  @@index([tenantId, id], map: "households_tenant_id_id_idx")
  @@map("households")
}

/// Resident represents an individual person within a household.
/// Supports soft delete via deleted_at timestamp.
model Resident {
  id                          String          @id @default(uuid()) @map("id")
  tenantId                    String          @map("tenant_id")
  householdId                 String          @map("household_id")
  name                        String          @map("name")
  nik                         String          @map("nik")
  dateOfBirth                 DateTime        @map("date_of_birth")
  gender                      Gender          @map("gender")
  phone                       String?         @map("phone")
  status                      ResidencyStatus @default(tetap) @map("status")
  categories                  String[]        @map("categories")
  emergencyContactName        String?         @map("emergency_contact_name")
  emergencyContactPhone       String?         @map("emergency_contact_phone")
  emergencyContactRelationship String?        @map("emergency_contact_relationship")
  createdAt                   DateTime        @default(now()) @map("created_at")
  updatedAt                   DateTime        @updatedAt @map("updated_at")
  deletedAt                   DateTime?       @map("deleted_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  household Household @relation(fields: [householdId], references: [id])

  @@unique([tenantId, nik], map: "residents_tenant_id_nik_unique")
  @@index([tenantId, id], map: "residents_tenant_id_id_idx")
  @@index([tenantId, createdAt], map: "residents_tenant_id_created_at_idx")
  @@index([tenantId, status], map: "residents_tenant_id_status_idx")
  @@map("residents")
}

/// FinancialTransaction represents an income or expense entry in the tenant's
/// community treasury (uang kas). Supports soft delete via deleted_at.
model FinancialTransaction {
  id          String          @id @default(uuid()) @map("id")
  tenantId    String          @map("tenant_id")
  type        TransactionType @map("type")
  amount      Decimal         @map("amount") @db.Decimal(12, 2)
  description String          @map("description")
  category    String          @map("category")
  date        DateTime        @map("date")
  createdBy   String          @map("created_by")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  deletedAt   DateTime?       @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, id], map: "financial_transactions_tenant_id_id_idx")
  @@index([tenantId, createdAt], map: "financial_transactions_tenant_id_created_at_idx")
  @@index([tenantId, date], map: "financial_transactions_tenant_id_date_idx")
  @@map("financial_transactions")
}

/// IuranStatus tracks the monthly dues (iuran) payment status for each
/// household within a tenant. One record per household per month.
model IuranStatus {
  id            String             @id @default(uuid()) @map("id")
  tenantId      String             @map("tenant_id")
  householdId   String             @map("household_id")
  month         String             @map("month") // YYYY-MM format
  status        IuranPaymentStatus @default(unpaid) @map("status")
  paidAt        DateTime?          @map("paid_at")
  transactionId String?            @map("transaction_id")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  household Household @relation(fields: [householdId], references: [id])

  @@unique([tenantId, householdId, month], map: "iuran_statuses_tenant_id_household_id_month_unique")
  @@index([tenantId, id], map: "iuran_statuses_tenant_id_id_idx")
  @@map("iuran_statuses")
}

/// Vote represents a community poll/vote created within a tenant.
/// Supports anonymous and verified voting modes.
model Vote {
  id          String   @id @default(uuid()) @map("id")
  tenantId    String   @map("tenant_id")
  title       String   @map("title")
  description String   @map("description")
  mode        VoteMode @map("mode")
  deadline    DateTime @map("deadline")
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant  Tenant       @relation(fields: [tenantId], references: [id])
  options VoteOption[]
  ballots Ballot[]

  @@index([tenantId, id], map: "votes_tenant_id_id_idx")
  @@index([tenantId, createdAt], map: "votes_tenant_id_created_at_idx")
  @@map("votes")
}

/// VoteOption represents a selectable option belonging to a vote.
model VoteOption {
  id        String @id @default(uuid()) @map("id")
  voteId    String @map("vote_id")
  label     String @map("label")
  voteCount Int    @default(0) @map("vote_count")

  vote Vote @relation(fields: [voteId], references: [id])

  @@index([voteId], map: "vote_options_vote_id_idx")
  @@map("vote_options")
}

/// Ballot represents a vote cast by a user for a specific option.
/// The unique constraint on (voteId, userId) prevents duplicate voting.
model Ballot {
  id        String   @id @default(uuid()) @map("id")
  voteId    String   @map("vote_id")
  userId    String   @map("user_id")
  optionId  String   @map("option_id")
  createdAt DateTime @default(now()) @map("created_at")

  vote Vote @relation(fields: [voteId], references: [id])

  @@unique([voteId, userId], map: "ballots_vote_id_user_id_unique")
  @@map("ballots")
}

/// Announcement represents a community announcement within a tenant.
/// Supports categories: umum, keamanan, keuangan, kegiatan, darurat.
model Announcement {
  id          String               @id @default(uuid()) @map("id")
  tenantId    String               @map("tenant_id")
  title       String               @map("title")
  content     String               @map("content")
  category    AnnouncementCategory @map("category")
  createdBy   String               @map("created_by")
  publishedAt DateTime?            @map("published_at")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  tenant      Tenant                     @relation(fields: [tenantId], references: [id])
  attachments AnnouncementAttachment[]

  @@index([tenantId, id], map: "announcements_tenant_id_id_idx")
  @@index([tenantId, createdAt], map: "announcements_tenant_id_created_at_idx")
  @@map("announcements")
}

enum EmergencyAlertStatus {
  active
  responding
  resolved
}

/// AnnouncementAttachment represents a file attached to an announcement.
/// Each announcement can have up to 5 attachments (enforced at application level).
model AnnouncementAttachment {
  id             String   @id @default(uuid()) @map("id")
  announcementId String   @map("announcement_id")
  fileUrl        String   @map("file_url")
  fileName       String   @map("file_name")
  fileSize       Int      @map("file_size")
  mimeType       String   @map("mime_type")
  createdAt      DateTime @default(now()) @map("created_at")

  announcement Announcement @relation(fields: [announcementId], references: [id])

  @@index([announcementId], map: "announcement_attachments_announcement_id_idx")
  @@map("announcement_attachments")
}

/// EmergencyAlert represents an emergency alert triggered by a Warga.
/// Tracks GPS coordinates (if available) and alert status lifecycle.
model EmergencyAlert {
  id                   String               @id @default(uuid()) @map("id")
  tenantId             String               @map("tenant_id")
  userId               String               @map("user_id")
  latitude             Float?               @map("latitude")
  longitude            Float?               @map("longitude")
  locationUnavailable  Boolean              @default(false) @map("location_unavailable")
  status               EmergencyAlertStatus @default(active) @map("status")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, id], map: "emergency_alerts_tenant_id_id_idx")
  @@index([tenantId, status], map: "emergency_alerts_tenant_id_status_idx")
  @@map("emergency_alerts")
}

// =============================================================================
// Security Patrol Enums & Models
// =============================================================================

enum SeverityLevel {
  low
  medium
  high
  critical
}

/// PatrolSchedule represents a security patrol schedule within a tenant.
model PatrolSchedule {
  id              String   @id @default(uuid()) @map("id")
  tenantId        String   @map("tenant_id")
  date            DateTime @map("date")
  timeSlot        String   @map("time_slot")
  assignedUserIds String[] @map("assigned_user_ids")
  createdBy       String   @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  attendances PatrolAttendance[]

  @@index([tenantId, id], map: "patrol_schedules_tenant_id_id_idx")
  @@index([tenantId, date], map: "patrol_schedules_tenant_id_date_idx")
  @@map("patrol_schedules")
}

/// PatrolAttendance represents a security guard's check-in for a patrol schedule.
model PatrolAttendance {
  id               String   @id @default(uuid()) @map("id")
  scheduleId       String   @map("schedule_id")
  userId           String   @map("user_id")
  checkInTimestamp DateTime @map("check_in_timestamp")
  createdAt        DateTime @default(now()) @map("created_at")

  schedule PatrolSchedule @relation(fields: [scheduleId], references: [id])

  @@index([scheduleId], map: "patrol_attendances_schedule_id_idx")
  @@map("patrol_attendances")
}

/// IncidentReport represents a security incident report within a tenant.
model IncidentReport {
  id            String        @id @default(uuid()) @map("id")
  tenantId      String        @map("tenant_id")
  date          DateTime      @map("date")
  time          String        @map("time")
  description   String        @map("description")
  location      String        @map("location")
  severityLevel SeverityLevel @map("severity_level")
  reportedBy    String        @map("reported_by")
  createdAt     DateTime      @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, id], map: "incident_reports_tenant_id_id_idx")
  @@index([tenantId, createdAt], map: "incident_reports_tenant_id_created_at_idx")
  @@map("incident_reports")
}

// =============================================================================
// Administration Enums & Models
// =============================================================================

enum LetterType {
  surat_pengantar
  domisili
  SKTM
}

enum LetterRequestStatus {
  pending
  approved
  rejected
}

/// LetterRequest represents an administrative letter request within a tenant.
model LetterRequest {
  id              String              @id @default(uuid()) @map("id")
  tenantId        String              @map("tenant_id")
  userId          String              @map("user_id")
  letterType      LetterType          @map("letter_type")
  purpose         String              @map("purpose")
  status          LetterRequestStatus @default(pending) @map("status")
  rejectionReason String?             @map("rejection_reason")
  documentUrl     String?             @map("document_url")
  decidedBy       String?             @map("decided_by")
  decidedAt       DateTime?           @map("decided_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, id], map: "letter_requests_tenant_id_id_idx")
  @@index([tenantId, createdAt], map: "letter_requests_tenant_id_created_at_idx")
  @@index([tenantId, userId], map: "letter_requests_tenant_id_user_id_idx")
  @@map("letter_requests")
}


// =============================================================================
// Event Enums & Models
// =============================================================================

enum RsvpResponse {
  attending
  not_attending
}

/// CommunityEvent represents a community event within a tenant.
model CommunityEvent {
  id          String   @id @default(uuid()) @map("id")
  tenantId    String   @map("tenant_id")
  title       String   @map("title")
  description String   @map("description")
  date        DateTime @map("date")
  time        String   @map("time")
  location    String   @map("location")
  maxRsvp     Int?     @map("max_rsvp")
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant      @relation(fields: [tenantId], references: [id])
  rsvps  EventRsvp[]

  @@index([tenantId, id], map: "community_events_tenant_id_id_idx")
  @@index([tenantId, date], map: "community_events_tenant_id_date_idx")
  @@map("community_events")
}

/// EventRsvp represents an RSVP response to a community event.
/// The unique constraint on (eventId, userId) prevents duplicate RSVPs.
model EventRsvp {
  id        String       @id @default(uuid()) @map("id")
  eventId   String       @map("event_id")
  userId    String       @map("user_id")
  response  RsvpResponse @map("response")
  createdAt DateTime     @default(now()) @map("created_at")

  event CommunityEvent @relation(fields: [eventId], references: [id])

  @@unique([eventId, userId], map: "event_rsvps_event_id_user_id_unique")
  @@map("event_rsvps")
}

// =============================================================================
// Visitor & Package Log Models
// =============================================================================

/// VisitorLog represents a visitor entry log within a tenant.
model VisitorLog {
  id                     String    @id @default(uuid()) @map("id")
  tenantId               String    @map("tenant_id")
  visitorName            String    @map("visitor_name")
  purpose                String    @map("purpose")
  destinationHouseholdId String    @map("destination_household_id")
  entryTimestamp         DateTime  @default(now()) @map("entry_timestamp")
  exitTimestamp          DateTime? @map("exit_timestamp")
  loggedBy               String    @map("logged_by")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, id], map: "visitor_logs_tenant_id_id_idx")
  @@index([tenantId, createdAt], map: "visitor_logs_tenant_id_created_at_idx")
  @@map("visitor_logs")
}

/// PackageLog represents a package delivery log within a tenant.
model PackageLog {
  id                   String    @id @default(uuid()) @map("id")
  tenantId             String    @map("tenant_id")
  recipientHouseholdId String    @map("recipient_household_id")
  courierName          String    @map("courier_name")
  description          String    @map("description")
  arrivalTimestamp     DateTime  @default(now()) @map("arrival_timestamp")
  collectedAt          DateTime? @map("collected_at")
  loggedBy             String    @map("logged_by")
  createdAt            DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, id], map: "package_logs_tenant_id_id_idx")
  @@index([tenantId, createdAt], map: "package_logs_tenant_id_created_at_idx")
  @@map("package_logs")
}


// =============================================================================
// Billing Enums & Models
// =============================================================================

enum InvoiceStatus {
  pending
  paid
  failed
}

/// Invoice represents a billing invoice for a tenant's subscription.
/// Tracks billing period, payment status, and gateway transaction references.
model Invoice {
  id                   String        @id @default(uuid()) @map("id")
  tenantId             String        @map("tenant_id")
  planName             String        @map("plan_name")
  amount               Decimal       @map("amount") @db.Decimal(12, 2)
  billingPeriodStart   DateTime      @map("billing_period_start")
  billingPeriodEnd     DateTime      @map("billing_period_end")
  dueDate              DateTime      @map("due_date")
  status               InvoiceStatus @default(pending) @map("status")
  gatewayTransactionId String?       @map("gateway_transaction_id")
  paidAt               DateTime?     @map("paid_at")
  retryCount           Int           @default(0) @map("retry_count")
  idempotencyKey       String        @unique @map("idempotency_key")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status, dueDate], map: "invoices_tenant_id_status_due_date_idx")
  @@map("invoices")
}

/// PaymentReconciliation records the reconciliation between a payment gateway
/// transaction and an internal invoice for auditing purposes.
model PaymentReconciliation {
  id                   String    @id @default(uuid()) @map("id")
  gatewayTransactionId String    @map("gateway_transaction_id")
  internalInvoiceId    String    @map("internal_invoice_id")
  amount               Decimal   @map("amount") @db.Decimal(12, 2)
  status               String    @map("status")
  gatewayResponse      Json      @map("gateway_response")
  reconciledAt         DateTime? @map("reconciled_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  @@map("payment_reconciliations")
}

// =============================================================================
// Feature Flag Models
// =============================================================================

/// FeatureFlag maps a feature to a subscription plan with an enabled/disabled state.
model FeatureFlag {
  id          String  @id @default(uuid()) @map("id")
  featureName String  @map("feature_name")
  planId      String  @map("plan_id")
  enabled     Boolean @default(true) @map("enabled")

  @@map("feature_flags")
}

/// FeatureFlagOverride allows per-tenant overrides of feature flags.
model FeatureFlagOverride {
  id           String   @id @default(uuid()) @map("id")
  tenantId     String   @map("tenant_id")
  featureName  String   @map("feature_name")
  enabled      Boolean  @map("enabled")
  overriddenBy String   @map("overridden_by")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, featureName], map: "feature_flag_overrides_tenant_id_feature_name_unique")
  @@map("feature_flag_overrides")
}

// =============================================================================
// Notification Models
// =============================================================================

/// Notification represents a notification sent to a user within a tenant.
/// Supports push, email, and inbox channels.
model Notification {
  id        String   @id @default(uuid()) @map("id")
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  type      String   @map("type")
  title     String   @map("title")
  body      String   @map("body")
  channel   String   @map("channel") // push | email | inbox
  status    String   @default("unread") @map("status") // unread | read
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, userId, status, createdAt], map: "notifications_tenant_id_user_id_status_created_at_idx")
  @@map("notifications")
}

// =============================================================================
// Audit Log Models
// =============================================================================

/// AuditLog represents an append-only audit trail entry within a tenant.
/// Sensitive data (passwords, tokens, OTP) is excluded from details at write time.
model AuditLog {
  id              String   @id @default(uuid()) @map("id")
  tenantId        String   @map("tenant_id")
  actorUserId     String   @map("actor_user_id")
  actionType      String   @map("action_type")
  resourceType    String   @map("resource_type")
  resourceId      String   @map("resource_id")
  details         Json     @map("details")
  ipAddress       String?  @map("ip_address")
  impersonatorId  String?  @map("impersonator_id")
  timestamp       DateTime @default(now()) @map("timestamp")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, timestamp], map: "audit_logs_tenant_id_timestamp_idx")
  @@index([tenantId, actionType], map: "audit_logs_tenant_id_action_type_idx")
  @@map("audit_logs")
}

// =============================================================================
// Push Subscription Models
// =============================================================================

/// PushSubscription stores Web Push subscription data for push notifications.
model PushSubscription {
  id        String   @id @default(uuid()) @map("id")
  userId    String   @map("user_id")
  tenantId  String   @map("tenant_id")
  endpoint  String   @map("endpoint")
  p256dhKey String   @map("p256dh_key")
  authKey   String   @map("auth_key")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([userId, endpoint], map: "push_subscriptions_user_id_endpoint_unique")
  @@index([tenantId, userId], map: "push_subscriptions_tenant_id_user_id_idx")
  @@map("push_subscriptions")
}

// =============================================================================
// IoT Device Enums & Models
// =============================================================================

enum IoTDeviceType {
  panic_button
  smart_siren
  smart_lock
  cctv
  motion_sensor
  smoke_detector
  door_sensor
  gate_sensor
  smart_switch
  smart_lighting
}

enum IoTDeviceOnlineStatus {
  online
  offline
}

enum DeviceEventType {
  panic_button_pressed
  gate_open
  gate_closed
  motion_detected
  smoke_detected
  alarm_triggered
  smart_lock_opened
  cctv_motion_detected
  device_online
  device_offline
  battery_low
  emergency_alert
  smart_switch_toggled
  lighting_changed
  gate_open_too_long
  motion_detection_alert
  door_opened
  door_closed
  door_opened_during_window
}

/// IoTDevice represents a smart home device paired with a Household via Tuya IoT Cloud.
/// Each device belongs to a tenant and is associated with a specific household.
model IoTDevice {
  id           String                @id @default(uuid()) @map("id")
  tenantId     String                @map("tenant_id")
  householdId  String                @map("household_id")
  tuyaDeviceId String                @map("tuya_device_id")
  deviceType   IoTDeviceType         @map("device_type")
  name         String                @map("name")
  onlineStatus IoTDeviceOnlineStatus @default(offline) @map("online_status")
  batteryLevel Int?                  @map("battery_level")
  lastSeen     DateTime              @default(now()) @map("last_seen")
  metadata     Json                  @default("{}") @map("metadata")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  household        Household         @relation(fields: [householdId], references: [id])
  events           DeviceEvent[]
  doorSensorConfig DoorSensorConfig?

  @@unique([tuyaDeviceId], map: "iot_devices_tuya_device_id_unique")
  @@index([tenantId, householdId], map: "iot_devices_tenant_id_household_id_idx")
  @@map("iot_devices")
}

/// DeviceEvent represents an event generated by an IoT device (e.g. panic button pressed,
/// motion detected, device offline). Events flagged as shared security are visible to
/// Ketua_RT, Pengurus, and Security_Guard roles.
model DeviceEvent {
  id               String          @id @default(uuid()) @map("id")
  deviceId         String          @map("device_id")
  tenantId         String          @map("tenant_id")
  eventType        DeviceEventType @map("event_type")
  payload          Json            @default("{}") @map("payload")
  isSharedSecurity Boolean         @default(false) @map("is_shared_security")
  processedAt      DateTime?       @map("processed_at")
  createdAt        DateTime        @default(now()) @map("created_at")

  device IoTDevice @relation(fields: [deviceId], references: [id])

  @@index([deviceId, createdAt], map: "device_events_device_id_created_at_idx")
  @@index([tenantId, eventType, createdAt], map: "device_events_tenant_id_event_type_created_at_idx")
  @@index([tenantId, isSharedSecurity, createdAt], map: "device_events_tenant_id_is_shared_security_created_at_idx")
  @@map("device_events")
}

// =============================================================================
// Incident Management Enums & Models
// =============================================================================

enum IncidentSeverity {
  low
  medium
  high
  critical
}

enum IncidentCategory {
  theft
  vandalism
  trespassing
  fire
  flood
  suspicious_activity
  noise_complaint
  device_alert
  other
}

enum IncidentStatus {
  open
  acknowledged
  in_progress
  escalated
  resolved
  closed
}

/// Incident represents a security incident reported within a tenant community.
/// Tracks full lifecycle from creation through resolution with evidence and assignment.
/// @see Requirements 32.1, 32.2, 32.3, 32.6
model Incident {
  id           String           @id @default(uuid()) @map("id")
  tenantId     String           @map("tenant_id")
  title        String           @map("title")
  description  String           @map("description")
  location     String           @map("location")
  latitude     Float?           @map("latitude")
  longitude    Float?           @map("longitude")
  severity     IncidentSeverity @map("severity")
  category     IncidentCategory @map("category")
  status       IncidentStatus   @default(open) @map("status")
  reportedBy   String           @map("reported_by")
  assignedTo   String?          @map("assigned_to")
  evidenceUrls String[]         @map("evidence_urls")
  escalatedAt  DateTime?        @map("escalated_at")
  resolvedAt   DateTime?        @map("resolved_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  logs   IncidentLog[]

  @@index([tenantId, status], map: "incidents_tenant_id_status_idx")
  @@index([tenantId, severity], map: "incidents_tenant_id_severity_idx")
  @@index([tenantId, createdAt], map: "incidents_tenant_id_created_at_idx")
  @@map("incidents")
}

/// IncidentLog represents a status change or note entry in an incident's lifecycle.
/// Each log entry records who made the change, the new status, and optional notes.
/// @see Requirement 32.4
model IncidentLog {
  id         String         @id @default(uuid()) @map("id")
  incidentId String         @map("incident_id")
  status     IncidentStatus @map("status")
  notes      String?        @map("notes")
  actorId    String         @map("actor_id")
  timestamp  DateTime       @default(now()) @map("timestamp")

  incident Incident @relation(fields: [incidentId], references: [id])

  @@index([incidentId, timestamp], map: "incident_logs_incident_id_timestamp_idx")
  @@map("incident_logs")
}

// =============================================================================
// Gate Monitoring Enums & Models
// =============================================================================

enum GateStatus {
  open
  closed
  offline
}

enum GateEventState {
  gate_open
  gate_closed
}

/// Gate represents a community gate monitored via IoT sensor within a tenant.
/// Tracks real-time open/closed/offline status and location coordinates.
/// @see Requirements 33.1, 33.2, 33.7
model Gate {
  id              String     @id @default(uuid()) @map("id")
  tenantId        String     @map("tenant_id")
  name            String     @map("name")
  location        String     @map("location")
  latitude        Float      @map("latitude")
  longitude       Float      @map("longitude")
  deviceId        String     @map("device_id")
  status          GateStatus @default(closed) @map("status")
  lastStateChange DateTime   @default(now()) @map("last_state_change")
  createdAt       DateTime   @default(now()) @map("created_at")

  tenant Tenant      @relation(fields: [tenantId], references: [id])
  events GateEvent[]

  @@index([tenantId, status], map: "gates_tenant_id_status_idx")
  @@map("gates")
}

/// GateEvent represents a single open/close event recorded by a gate sensor.
/// Each event captures the new state and the duration (in seconds) of the previous state.
/// @see Requirements 33.2, 33.6
model GateEvent {
  id        String         @id @default(uuid()) @map("id")
  gateId    String         @map("gate_id")
  tenantId  String         @map("tenant_id")
  state     GateEventState @map("state")
  duration  Int            @map("duration")
  timestamp DateTime       @default(now()) @map("timestamp")

  gate Gate @relation(fields: [gateId], references: [id])

  @@index([gateId, timestamp], map: "gate_events_gate_id_timestamp_idx")
  @@index([tenantId, timestamp], map: "gate_events_tenant_id_timestamp_idx")
  @@map("gate_events")
}

// =============================================================================
// CCTV Monitoring Enums & Models
// =============================================================================

enum CctvCameraStatus {
  online
  offline
  motion_detected
}

enum CctvSnapshotTriggerType {
  manual
  motion
  scheduled
}

/// CctvCamera represents a CCTV camera registered within a tenant for community
/// security monitoring. RTSP stream URL is encrypted at rest (AES-256).
/// @see Requirements 34.1, 34.6, 34.8, 34.10
model CctvCamera {
  id         String           @id @default(uuid()) @map("id")
  tenantId   String           @map("tenant_id")
  name       String           @map("name")
  rtspUrl    String           @map("rtsp_url") /// Encrypted at rest (AES-256)
  location   String           @map("location")
  latitude   Float            @map("latitude")
  longitude  Float            @map("longitude")
  resolution String           @map("resolution")
  status     CctvCameraStatus @default(online) @map("status")
  lastOnline DateTime         @default(now()) @map("last_online")
  createdAt  DateTime         @default(now()) @map("created_at")

  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  snapshots CctvSnapshot[]

  @@index([tenantId, status], map: "cctv_cameras_tenant_id_status_idx")
  @@map("cctv_cameras")
}

/// CctvSnapshot represents a still image captured from a CCTV camera stream.
/// Snapshots can be triggered manually, by motion detection, or on a schedule.
/// @see Requirements 34.3, 34.4, 34.5
model CctvSnapshot {
  id          String                  @id @default(uuid()) @map("id")
  cameraId    String                  @map("camera_id")
  tenantId    String                  @map("tenant_id")
  fileUrl     String                  @map("file_url")
  triggerType CctvSnapshotTriggerType @map("trigger_type")
  timestamp   DateTime                @default(now()) @map("timestamp")

  camera CctvCamera @relation(fields: [cameraId], references: [id])

  @@index([cameraId, timestamp], map: "cctv_snapshots_camera_id_timestamp_idx")
  @@index([tenantId, timestamp], map: "cctv_snapshots_tenant_id_timestamp_idx")
  @@map("cctv_snapshots")
}


// =============================================================================
// Patrol Route Tracking Enums & Models
// =============================================================================

enum PatrolSessionStatus {
  active
  completed
  abandoned
}

/// PatrolRoute represents a predefined patrol route with ordered checkpoints
/// within a tenant community. Guards follow these routes during patrol sessions.
/// @see Requirements 35.1, 35.2
model PatrolRoute {
  id                String   @id @default(uuid()) @map("id")
  tenantId          String   @map("tenant_id")
  name              String   @map("name")
  checkpoints       Json     @map("checkpoints") /// JSON array of {lat, lng, label}
  estimatedDuration Int      @map("estimated_duration") /// Duration in minutes
  createdBy         String   @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at")

  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  sessions PatrolSession[]

  @@index([tenantId, createdAt], map: "patrol_routes_tenant_id_created_at_idx")
  @@map("patrol_routes")
}

/// PatrolSession represents an active or completed patrol session by a security guard.
/// Tracks progress along a route including checkpoints visited and distance traveled.
/// @see Requirements 35.3, 35.5, 35.8
model PatrolSession {
  id                  String             @id @default(uuid()) @map("id")
  tenantId            String             @map("tenant_id")
  routeId             String             @map("route_id")
  guardId             String             @map("guard_id")
  status              PatrolSessionStatus @default(active) @map("status")
  startedAt           DateTime           @default(now()) @map("started_at")
  completedAt         DateTime?          @map("completed_at")
  checkpointsVisited  Int                @default(0) @map("checkpoints_visited")
  distanceTraveled    Float              @default(0) @map("distance_traveled") /// Distance in meters
  createdAt           DateTime           @default(now()) @map("created_at")

  tenant          Tenant                  @relation(fields: [tenantId], references: [id])
  route           PatrolRoute             @relation(fields: [routeId], references: [id])
  checkpointVisits PatrolCheckpointVisit[]

  @@index([tenantId, guardId, status], map: "patrol_sessions_tenant_id_guard_id_status_idx")
  @@map("patrol_sessions")
}

/// PatrolCheckpointVisit represents a single checkpoint visit recorded during
/// a patrol session. Captures the guard's GPS position and distance from checkpoint.
/// @see Requirements 35.4, 35.5
model PatrolCheckpointVisit {
  id                      String   @id @default(uuid()) @map("id")
  sessionId               String   @map("session_id")
  checkpointIndex         Int      @map("checkpoint_index")
  latitude                Float    @map("latitude")
  longitude               Float    @map("longitude")
  visitedAt               DateTime @default(now()) @map("visited_at")
  distanceFromCheckpoint  Float    @map("distance_from_checkpoint") /// Distance in meters

  session PatrolSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId, visitedAt], map: "patrol_checkpoint_visits_session_id_visited_at_idx")
  @@map("patrol_checkpoint_visits")
}

// =============================================================================
// Alarm System Enums & Models
// =============================================================================

enum AlarmDeviceStatus {
  armed
  disarmed
  triggered
  offline
}

enum AlarmTriggerSource {
  manual
  automation
  schedule
}

/// AlarmDevice represents a smart siren device registered within a tenant
/// for community alarm/alert purposes. Supports zone-based grouping and scheduling.
/// @see Requirements 36.1, 36.4
model AlarmDevice {
  id             String            @id @default(uuid()) @map("id")
  tenantId       String            @map("tenant_id")
  name           String            @map("name")
  location       String            @map("location")
  deviceId       String            @map("device_id")
  zones          String[]          @map("zones")
  scheduleArm    String?           @map("schedule_arm")
  scheduleDisarm String?           @map("schedule_disarm")
  status         AlarmDeviceStatus @default(disarmed) @map("status")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id])
  events AlarmEvent[]

  @@index([tenantId, status], map: "alarm_devices_tenant_id_status_idx")
  @@map("alarm_devices")
}

/// AlarmEvent represents a single alarm activation or deactivation event
/// recorded by the alarm system. Captures trigger source, duration, and timestamps.
/// @see Requirements 36.1, 36.4
model AlarmEvent {
  id             String             @id @default(uuid()) @map("id")
  alarmDeviceId  String             @map("alarm_device_id")
  tenantId       String             @map("tenant_id")
  triggerSource  AlarmTriggerSource @map("trigger_source")
  triggerType    String             @map("trigger_type")
  duration       Int                @map("duration")
  activatedAt    DateTime           @default(now()) @map("activated_at")
  deactivatedAt  DateTime?          @map("deactivated_at")

  alarmDevice AlarmDevice @relation(fields: [alarmDeviceId], references: [id])

  @@index([alarmDeviceId, activatedAt], map: "alarm_events_alarm_device_id_activated_at_idx")
  @@index([tenantId, activatedAt], map: "alarm_events_tenant_id_activated_at_idx")
  @@map("alarm_events")
}

// =============================================================================
// Automation Rule Engine Enums & Models
// =============================================================================

enum AutomationExecutionStatus {
  success
  partial_failure
  failure
}

/// AutomationRule represents an IF/THEN automation rule that triggers actions
/// when specific security or IoT events occur within a tenant community.
/// @see Requirements 39.1, 39.8
model AutomationRule {
  id               String    @id @default(uuid()) @map("id")
  tenantId         String    @map("tenant_id")
  name             String    @map("name")
  triggerEventType String    @map("trigger_event_type")
  conditions       Json      @map("conditions")
  actions          Json      @map("actions")
  enabled          Boolean   @default(true) @map("enabled")
  scheduleStart    String?   @map("schedule_start")
  scheduleEnd      String?   @map("schedule_end")
  maxChainDepth    Int       @default(5) @map("max_chain_depth")
  executionCount   Int       @default(0) @map("execution_count")
  lastExecutedAt   DateTime? @map("last_executed_at")
  createdBy        String    @map("created_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tenant     Tenant                @relation(fields: [tenantId], references: [id])
  executions AutomationExecution[]

  @@index([tenantId, enabled], map: "automation_rules_tenant_id_enabled_idx")
  @@index([tenantId, triggerEventType, enabled], map: "automation_rules_tenant_id_trigger_event_type_enabled_idx")
  @@map("automation_rules")
}

/// AutomationExecution represents a single execution record of an automation rule.
/// Every time a rule is triggered and evaluated, an execution record is created
/// regardless of whether actions succeeded or failed.
/// @see Requirements 39.5, 39.8
model AutomationExecution {
  id                  String                    @id @default(uuid()) @map("id")
  ruleId              String                    @map("rule_id")
  tenantId            String                    @map("tenant_id")
  triggerEvent        Json                      @map("trigger_event")
  conditionsEvaluated Boolean                   @map("conditions_evaluated")
  actionsExecuted     String[]                  @map("actions_executed")
  durationMs          Int                       @map("duration_ms")
  status              AutomationExecutionStatus @map("status")
  error               String?                   @map("error")
  executedAt          DateTime                  @default(now()) @map("executed_at")

  rule AutomationRule @relation(fields: [ruleId], references: [id])

  @@index([ruleId, executedAt], map: "automation_executions_rule_id_executed_at_idx")
  @@index([tenantId, executedAt], map: "automation_executions_tenant_id_executed_at_idx")
  @@map("automation_executions")
}

/// Home represents a SocieT-Home instance linking a Home_Owner to their Household
/// for smart home device management, dashboard access, and alert configuration.
/// @see Requirements 37.1, 37.2, 37.5
model Home {
  id          String   @id @default(uuid()) @map("id")
  tenantId    String   @map("tenant_id")
  householdId String   @map("household_id")
  ownerId     String   @map("owner_id")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, householdId], map: "homes_tenant_id_household_id_idx")
  @@index([ownerId], map: "homes_owner_id_idx")
  @@map("homes")
}

// =============================================================================
// Door Monitoring Enums & Models
// =============================================================================

/// Physical open/closed state most recently reported by a household door sensor.
enum DoorState {
  open
  closed
  unknown
}

/// Lifecycle of an RT-submitted request to have a door sensor installed for a
/// household. Only a platform admin (Super_Admin) may approve + register the
/// physical device id; the RT can only request installation.
enum DoorInstallationStatus {
  pending
  approved
  rejected
}

/// DoorSensorConfig holds the per-household door-sensor configuration:
/// which physical Tuya sensor is bound to the household, which siren zone to
/// trigger when the door opens during the monitoring window, and the
/// resident-configured monitoring window (usually night hours).
///
/// One household has at most one door-sensor config (1:1). The device id is set
/// only by a platform admin; the monitoring window is set by the resident.
model DoorSensorConfig {
  id             String    @id @default(uuid()) @map("id")
  tenantId       String    @map("tenant_id")
  householdId    String    @unique @map("household_id")
  /// FK to the registered IoTDevice (door_sensor). Null until an admin registers one.
  iotDeviceId    String?   @unique @map("iot_device_id")
  /// Siren zone to activate when the door opens during the monitoring window.
  sirenZone      String?   @map("siren_zone")
  /// Monitoring window start in HH:mm (24h), interpreted in the app timezone.
  monitorStart   String    @default("22:00") @map("monitor_start")
  /// Monitoring window end in HH:mm (24h). May wrap past midnight (e.g. 22:00->05:00).
  monitorEnd     String    @default("05:00") @map("monitor_end")
  /// Whether the resident has monitoring enabled.
  enabled        Boolean   @default(false) @map("enabled")
  /// Last known physical door state (updated by webhook events).
  currentState   DoorState @default(unknown) @map("current_state")
  lastStateChange DateTime? @map("last_state_change")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  household Household  @relation(fields: [householdId], references: [id])
  device    IoTDevice? @relation(fields: [iotDeviceId], references: [id])

  @@index([tenantId, enabled], map: "door_sensor_configs_tenant_id_enabled_idx")
  @@index([tenantId, currentState], map: "door_sensor_configs_tenant_id_current_state_idx")
  @@map("door_sensor_configs")
}

/// DoorInstallationRequest is raised by an RT (Ketua_RT/Pengurus) to request that
/// a platform admin install & register a door sensor for a household. It is an
/// approval workflow: the RT requests, the admin approves and registers the device.
model DoorInstallationRequest {
  id          String                 @id @default(uuid()) @map("id")
  tenantId    String                 @map("tenant_id")
  householdId String                 @map("household_id")
  requestedBy String                 @map("requested_by")
  status      DoorInstallationStatus @default(pending) @map("status")
  note        String?                @map("note")
  /// Admin resolution metadata.
  resolvedBy  String?                @map("resolved_by")
  resolvedAt  DateTime?              @map("resolved_at")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  household Household @relation(fields: [householdId], references: [id])

  @@index([tenantId, status, createdAt], map: "door_installation_requests_tenant_id_status_created_at_idx")
  @@index([householdId], map: "door_installation_requests_household_id_idx")
  @@map("door_installation_requests")
}

// =============================================================================
// Emergency Contacts Enums & Models
// =============================================================================

/// Category of an emergency contact, used for grouping/iconography in the UI.
enum EmergencyContactCategory {
  police
  ambulance
  fire
  hospital
  security
  rt_officer
  other
}

/// EmergencyContact is a callable emergency phone number configured PER RT
/// (tenant). Admins (Ketua_RT / Pengurus / Super_Admin) manage the list;
/// residents view it and tap to call.
model EmergencyContact {
  id          String                   @id @default(uuid()) @map("id")
  tenantId    String                   @map("tenant_id")
  label       String                   @map("label")
  phone       String                   @map("phone")
  category    EmergencyContactCategory @default(other) @map("category")
  description String?                  @map("description")
  /// Lower sorts first in the resident list.
  sortOrder   Int                      @default(0) @map("sort_order")
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, sortOrder], map: "emergency_contacts_tenant_id_sort_order_idx")
  @@map("emergency_contacts")
}

