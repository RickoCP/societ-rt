  @@index([tenantId, enabled], map: "automation_rules_tenant_id_enabled_idx")
  @@index([tenantId, triggerEventType, enabled], map: "automation_rules_tenant_id_trigger_event_type_enabled_idx")
  @@map("automation_rules")
}

/// AutomationExecution represents a single execution record of an automation rule.
/// Every time a rule is triggered and evaluated, an execution record is created
