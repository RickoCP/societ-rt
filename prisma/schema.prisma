// =============================================================================
// Incident Management Enums & Models
// =============================================================================

enum IncidentSeverity {
  low
  medium
  high
  critical
}

enum IncidentCategory {
  theft
  vandalism
  trespassing
  fire
  flood
  suspicious_activity
  noise_complaint
  device_alert
  other
}

enum IncidentStatus {
  open
  acknowledged
  in_progress
  escalated
  resolved
  closed
}

/// Incident represents a security incident reported within a tenant community.
/// Tracks full lifecycle from creation through resolution with evidence and assignment.
/// @see Requirements 32.1, 32.2, 32.3, 32.6
model Incident {
  id           String           @id @default(uuid()) @map("id")
  tenantId     String           @map("tenant_id")
  title        String           @map("title")
  description  String           @map("description")
  location     String           @map("location")
  latitude     Float?           @map("latitude")
  longitude    Float?           @map("longitude")
  severity     IncidentSeverity @map("severity")
  category     IncidentCategory @map("category")
  status       IncidentStatus   @default(open) @map("status")
  reportedBy   String           @map("reported_by")
  assignedTo   String?          @map("assigned_to")
  evidenceUrls String[]         @map("evidence_urls")
  escalatedAt  DateTime?        @map("escalated_at")
  resolvedAt   DateTime?        @map("resolved_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  logs   IncidentLog[]

  @@index([tenantId, status], map: "incidents_tenant_id_status_idx")
  @@index([tenantId, severity], map: "incidents_tenant_id_severity_idx")
  @@index([tenantId, createdAt], map: "incidents_tenant_id_created_at_idx")
  @@map("incidents")
}

/// IncidentLog represents a status change or note entry in an incident's lifecycle.
/// Each log entry records who made the change, the new status, and optional notes.
/// @see Requirement 32.4
model IncidentLog {
  id         String         @id @default(uuid()) @map("id")
  incidentId String         @map("incident_id")
  status     IncidentStatus @map("status")
  notes      String?        @map("notes")
  actorId    String         @map("actor_id")
  timestamp  DateTime       @default(now()) @map("timestamp")

  incident Incident @relation(fields: [incidentId], references: [id])

  @@index([incidentId, timestamp], map: "incident_logs_incident_id_timestamp_idx")
  @@map("incident_logs")
}

