/**
 * Debug script for login testing.
 * Run with: npx tsx scripts/test-login-debug.ts
 */

import { PrismaClient } from '../src/generated/prisma/client';
import { PrismaPg } from '@prisma/adapter-pg';
import pg from 'pg';
import bcrypt from 'bcryptjs';
import dotenv from 'dotenv';

dotenv.config();

async function main() {
  console.log('=== Login Debug Test ===');
  
  const databaseUrl = process.env.DATABASE_URL;
  if (!databaseUrl) {
    console.error('DATABASE_URL not set');
    process.exit(1);
  }
  
  console.log('1. Creating database connection...');
  const pool = new pg.Pool({
    connectionString: databaseUrl,
  });
  
  try {
    // Test pool connection
    const client = await pool.connect();
    console.log('   Database connected successfully');
    client.release();
    
    const adapter = new PrismaPg(pool);
    const prisma = new PrismaClient({ adapter });
    
    console.log('2. Looking up user ahmad@menteng.societ-rt.id...');
    const user = await prisma.user.findFirst({
      where: { 
        email: 'ahmad@menteng.societ-rt.id',
        tenantId: 'tenant_menteng',
        deletedAt: null,
      },
    });
    
    if (!user) {
      console.log('   User NOT FOUND');
      await prisma.\$disconnect\();
      await pool.end();
      process.exit(1);
    }
    
    console.log('   User found:');
    console.log('     - ID:', user.id);
    console.log('     - Name:', user.name);
    console.log('     - Email:', user.email);
    console.log('     - TenantId:', user.tenantId);
    console.log('     - Role:', user.role);
    console.log('     - PasswordHash (length):', user.passwordHash.length);
    
    console.log('3. Testing password comparison...');
    const password = 'Admin@123456';
    const match = await bcrypt.compare(password, user.passwordHash);
    console.log('   Password match:', match);
    
    console.log('4. Testing JWT signing...');
    const jwtSecret = process.env.JWT_SECRET;
    if (!jwtSecret) {
      console.log('   JWT_SECRET not set');
    } else {
      console.log('   JWT_SECRET length:', jwtSecret.length);
      console.log('   JWT_SECRET value:', jwtSecret);
    }
    
    console.log('=== Test Complete ===');
    
    await prisma.\$disconnect\();
    await pool.end();
    
  } catch (error) {
    console.error('Error:', error);
    await pool.end();
    process.exit(1);
  }
}

main();
